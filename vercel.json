{
  "rewrites": [{ "source": "/((?!assets/|favicon.png|favicon.svg|logo.png|logo-mark.png).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }]
}
